# --- Docker Compose (pila completa preferida) ---

POSTGRES_USER=cxrai

POSTGRES_PASSWORD=change-me

POSTGRES_DB=cxrai

WEB_PORT=8080



# Usado por el contenedor de la API (Compose sobrescribe el host de la BD)

DATABASE_URL=postgresql+psycopg://cxrai:change-me@db:5432/cxrai



# Alternativa SQLite local sin Docker (comenta DATABASE_URL arriba y desactívala):

# DATABASE_URL=sqlite:///./cxrai-dev.db



# Almacenamiento privado de archivos: local o azure

STORAGE_BACKEND=local

STORAGE_ROOT=.cxrai-storage



# Azure Blob (requerido solo cuando STORAGE_BACKEND=azure)

AZURE_STORAGE_CONNECTION_STRING=

AZURE_STORAGE_CONTAINER=cxrai-private



# Autenticación

SESSION_DAYS=7

SESSION_COOKIE_NAME=cxrai_session

CSRF_COOKIE_NAME=cxrai_csrf

SECURE_COOKIES=false



# Semilla de cuenta Master de demostración (el entrypoint de la API la crea si email+password están definidos)

CXRAI_MASTER_EMAIL=root@root.com

CXRAI_MASTER_PASSWORD=admin

CXRAI_MASTER_NAME=CXR AI Analyzer Master


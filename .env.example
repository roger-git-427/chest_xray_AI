# Local PostgreSQL (recommended)
DATABASE_URL=postgresql+psycopg://byteai:change-me@127.0.0.1:5432/byteai

# Private file storage: local or azure
STORAGE_BACKEND=local
STORAGE_ROOT=.byteai-storage

# Azure Blob (required only when STORAGE_BACKEND=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=byteai-private

# Authentication
SESSION_DAYS=7
SESSION_COOKIE_NAME=byteai_session
CSRF_COOKIE_NAME=byteai_csrf
SECURE_COOKIES=false

# One-time Master seed
BYTEAI_MASTER_EMAIL=master@example.com
BYTEAI_MASTER_PASSWORD=replace-with-a-long-random-password
BYTEAI_MASTER_NAME=ByteAI Master
